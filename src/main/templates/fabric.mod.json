{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "Sanseddy",
    "Cyber_Jellyfish"
  ],
  "contact": {
    "homepage": "https://github.com/1cyberjellyfish/cc-tweaked-unicode-support",
    "sources": "https://github.com/1cyberjellyfish/cc-tweaked-unicode-support"
  },
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "ru.sanseddy.cctweakedunicodesupport.fabric.CCTweakedUnicodeSupportFabric"
    ],
    "client": [
      "ru.sanseddy.cctweakedunicodesupport.fabric.CCTweakedUnicodeSupportFabric::initClient"
    ]
  },
  "mixins": [
    ${fabric_mixins}
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "${minecraft_version}",
    "fabric-api": "*",
    "computercraft": "*"
